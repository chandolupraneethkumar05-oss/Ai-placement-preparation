# =============================================================================
# VFSTR AutoPlace AI - Production & Development Environment Configuration
# =============================================================================

# Application Environment: 'production' | 'development' | 'testing'
APP_ENV=development

# Database Connection URL:
# Development default: sqlite:///./placement.db
# Production (Render Managed PostgreSQL): postgresql://username:password@hostname:5432/database_name
DATABASE_URL=sqlite:///./placement.db

# JWT Security & Encryption (Generate with: openssl rand -hex 32)
SECRET_KEY=vfstr-hackathon-2026-super-secret-key-agentic-ai

# Role Registration Gateways
# In production, set a strong institutional secret for administrator provisioning
ADMIN_INVITATION_KEY=VFSTR-ADMIN-SECURE-2026
RECRUITER_INVITATION_CODE=VFSTR-RECRUIT-2026

# Demo Personas One-Click Login (Enable in development/demo, disable in strict production)
ENABLE_DEMO_LOGIN=true

# Google Gemini API Key for AI Copilot, ATS Resume Optimization & Live Interview Mock Evaluation
GEMINI_API_KEY=your-gemini-api-key-here

# Resend Mail Gateway (Optional: for candidate interview pass dispatch)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=VFSTR Placements <onboarding@resend.dev>

# CORS Settings (Optional: defaults to '*' in full-stack unified mode)
FRONTEND_URL=*
PORT=8000
